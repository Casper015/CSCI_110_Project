{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++ Compile Run: Compile",
      "type": "shell",
      "command": "g++",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "-std=c++17",
        "-D_WIN32_WINNT=0x0A00",
        "${workspaceFolder}\\Mailv1.cpp",
        "-o",
        "${workspaceFolder}\\output\\Mailv1.exe",
        "-lws2_32"
      ],
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
